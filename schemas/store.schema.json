{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menhir.local/schemas/store-v1.json",
  "title": "Menhir application store v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "maintainers", "apps"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/i18n" },
    "description": { "$ref": "#/$defs/i18n" },
    "maintainers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" } }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "pattern": "^apps/[a-z0-9-]+/app\\.yaml$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "i18n": { "type": "object", "required": ["en", "fr"], "properties": { "en": { "type": "string", "minLength": 1 }, "fr": { "type": "string", "minLength": 1 } }, "additionalProperties": { "type": "string" } }
  }
}
